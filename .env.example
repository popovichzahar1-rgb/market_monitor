# Copy to .env for local runs. Never commit .env.
# In GitHub Actions the same names are set as repository Secrets.

# Telegram bot token from @BotFather (stage 4)
TELEGRAM_BOT_TOKEN=
# Your personal chat id; only this chat may use the bot (stage 4)
TELEGRAM_CHAT_ID=
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html (stage 2)
FRED_API_KEY=
# Contact e-mail for the SEC EDGAR User-Agent header (required by SEC fair access policy)
SEC_CONTACT_EMAIL=
# Passphrase used to encrypt the SQLite state on the public `data` branch (stage 6)
STATE_ENCRYPTION_KEY=
